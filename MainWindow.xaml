<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Player"
        Height="500"
        Width="800"
        Background="#121212">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Title -->
        <TextBlock Text="Music Player"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>


        <!-- Song list -->
        <ListBox x:Name="SongList"
                 Grid.Row="1"
                 Background="#1E1E1E"
                 Foreground="White"
                 FontSize="16"
                 SelectionChanged="SongList_SelectionChanged"/>


        <!-- Controls -->
        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    Margin="0,20,0,0">


            <TextBlock x:Name="NowPlaying"
                       Text="No song selected"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,0,0,10"/>


            <Slider x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="50"
                    ValueChanged="VolumeSlider_ValueChanged"/>


            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0">

                <Button Content="Open Folder"
                        Width="120"
                        Margin="5"
                        Click="OpenFolder_Click"/>

                <Button Content="▶ Play"
                        Width="100"
                        Margin="5"
                        Click="Play_Click"/>

                <Button Content="⏸ Pause"
                        Width="100"
                        Margin="5"
                        Click="Pause_Click"/>

                <Button Content="⏭ Next"
                        Width="100"
                        Margin="5"
                        Click="Next_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</Window>
